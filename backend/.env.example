PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/interviewapp
JWT_ACCESS_SECRET=your_access_token_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_refresh_token_secret_here_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
FRONTEND_URL=http://localhost:5173
REDIS_URL=redis://localhost:6379
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Object storage (S3) configuration — set these for production
S3_BUCKET=
AWS_REGION=us-east-1
# AWS credentials (or use instance role / environment-provider in production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional CDN hostname that fronts the S3 bucket (e.g. https://dxxxxx.cloudfront.net)
CDN_URL=
# Signed URL expiry in seconds (default 86400 = 1 day)
SIGNED_URL_EXPIRY=86400

# Optional: path for temporary uploads (defaults to backend/uploads)
UPLOADS_DIR=

# Media privacy — recordings & reference images are auto-deleted from local disk
# as soon as analysis/scoring completes. Set to true ONLY for debugging to keep them.
KEEP_MEDIA_AFTER_ANALYSIS=false

# ── Deployment / environment configuration ─────────────────────────────────────
# Whether the backend serves the built React frontend (college LAN self-hosting).
# Cloud deployments keep this false and host the frontend separately (e.g. nginx).
SERVE_FRONTEND=false
# Path to the built frontend (backend-relative or absolute). Defaults to ../frontend/dist.
FRONTEND_DIST_DIR=../frontend/dist

# Per-IP API request budget per window (unset => development 2000 / production 300).
RATE_LIMIT_MAX=
# Rate-limit window in milliseconds (default 900000 = 15 minutes).
RATE_LIMIT_WINDOW_MS=900000
# Per-IP request budget for the lightweight status-polling endpoint
# (unset => falls back to RATE_LIMIT_MAX, then the global default above).
STATUS_RATE_LIMIT_MAX=
# Status-polling window in milliseconds (defaults to RATE_LIMIT_WINDOW_MS).
STATUS_RATE_LIMIT_WINDOW_MS=

# Maximum answers analyzed in parallel within a single session (default 2).
ANALYSIS_CONCURRENCY=2
# Maximum sessions analyzed simultaneously. Unset => unlimited (original behavior).
# Set a small value (e.g. 2) on a single lab PC so simultaneous students do not
# overwhelm the machine; raise after benchmarking the actual hardware.
ANALYSIS_SESSION_CONCURRENCY=
