PORT=8003

# OpenRouter API key for LLM-based answer evaluation (free-tier models supported).
# Get one at https://openrouter.ai/keys. Leave empty to use the local NLP engine.
OPENROUTER_API_KEY=

# OpenRouter model for scoring. Free models (suffix ":free") cost $0/token.
# Examples:
#   nvidia/nemotron-3-super-120b-a12b:free   (top quality, high free token allowance)
#   openai/gpt-oss-20b:free                  (faster, smaller free allowance)
#   qwen/qwen3-coder:free                    (coding-focused)
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free