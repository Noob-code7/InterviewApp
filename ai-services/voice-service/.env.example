# Kokoro TTS (voice-service; default is the FP16 model - ~5-9x faster than INT8 on CPU)
# Paths default to <voice-service>/models/. URLs default to the kokoro-onnx
# model-files-v1.1 release. Model download failure is non-fatal (frontend
# falls back to browser speechSynthesis).
KOKORO_VOICE=af_heart
KOKORO_CACHE_ENABLED=true
KOKORO_NUM_THREADS=16
KOKORO_MODEL_PATH=
KOKORO_VOICES_PATH=
KOKORO_MODEL_URL=https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.1/kokoro-v1.0.fp16.onnx
KOKORO_VOICES_URL=https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.1/voices-v1.0.bin
KOKORO_MODEL_SIZE=163527961
KOKORO_VOICES_SIZE=28214398
# Optional integrity checks
KOKORO_MODEL_SHA256=
KOKORO_VOICES_SHA256=
