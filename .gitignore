# Dependencies
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# Build outputs
dist/
build/
*.egg-info/

# Environment files
.env
.env.local
.env.*.local

# HTTP cookie jars (curl); may accumulate session cookies over time
cookies.txt

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/settings.json
.idea/

# Docker volumes
mongo-data/
redis-data/

# Local uploads (do not commit user media files)
backend/uploads/

# Large model weights (download or generate locally, do not commit)
SER_model/*.pth
SER_model/*.zip

# Local LLM / SLM weights (avoid committing model binaries)
ai-services/nlp-service/models/

# Kokoro TTS model binaries (download on startup, do not commit)
ai-services/voice-service/models/

# Local scratch / verification scripts
scratch/
