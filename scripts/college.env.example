# ──────────────────────────────────────────────────────────────────────────────
# COLLEGE LAN / SELF-HOSTED deployment — example environment.
#
# Copy this file to backend/.env on the lab PC and fill in the placeholders.
# NEVER commit this file with real values. All values below are safe placeholders.
# The same codebase serves both cloud and college deployments: cloud keeps its
# existing .env (SERVE_FRONTEND=false, cloud MONGODB_URI, default limits) while
# this college configuration turns on single-origin serving and lab-appropriate
# limits.
# ──────────────────────────────────────────────────────────────────────────────

PORT=5000
NODE_ENV=production

# Local MongoDB on the lab PC (no Atlas credentials needed here).
MONGODB_URI=mongodb://127.0.0.1:27017/interviewapp

# Generate your own secrets (>= 32 chars). Do NOT reuse cloud secrets.
JWT_ACCESS_SECRET=<replace_with_generated_secret_min_32_chars>
JWT_REFRESH_SECRET=<replace_with_generated_secret_min_32_chars>
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# CORS fallback origin (used only if a second origin ever appears).
FRONTEND_URL=http://<lab-ip>:5000
REDIS_URL=redis://127.0.0.1:6379

# Node serves the built React app from one LAN URL (http://<lab-ip>:5000).
SERVE_FRONTEND=true
FRONTEND_DIST_DIR=../frontend/dist

# Many students share the lab PC's public IP, so per-IP budgets are higher here.
# Tune these after watching real usage; analysis load is governed by the queue,
# not by rate limiting.
RATE_LIMIT_MAX=3000
RATE_LIMIT_WINDOW_MS=900000
STATUS_RATE_LIMIT_MAX=1500
STATUS_RATE_LIMIT_WINDOW_MS=900000

# Intra-session parallel answers (unchanged default) and the conservative
# cross-session cap for one lab PC. Raise ANALYSIS_SESSION_CONCURRENCY after
# benchmarking the actual hardware (see backend/scripts/benchmark_concurrency_levels.js).
ANALYSIS_CONCURRENCY=2
ANALYSIS_SESSION_CONCURRENCY=2

# Recordings & reference images are deleted automatically after analysis.
KEEP_MEDIA_AFTER_ANALYSIS=false
